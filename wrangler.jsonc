{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "control-cabify",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./.output/public"
  },
  "observability": {
    "enabled": true
  }
}
